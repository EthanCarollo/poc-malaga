<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="POC Malaga · Génération locale"
        Width="1480" Height="900" MinWidth="1080" MinHeight="700"
        WindowStartupLocation="CenterScreen" Background="#11151C" Foreground="#F3F5F8"
        FontFamily="Segoe UI" FontSize="14">
  <Window.Resources>
    <SolidColorBrush x:Key="PanelBrush" Color="#191F28"/>
    <SolidColorBrush x:Key="PanelBorderBrush" Color="#29313D"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#98A3B4"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#4B7DFF"/>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="#F5F7FB"/>
      <Setter Property="Background" Value="#202833"/>
      <Setter Property="BorderBrush" Value="#303B4A"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="14,10"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="#2A3544"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.48"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Foreground" Value="#F3F5F8"/><Setter Property="Background" Value="#121720"/>
      <Setter Property="BorderBrush" Value="#303B4A"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="12"/><Setter Property="FontSize" Value="14"/>
      <Setter Property="CaretBrush" Value="#F3F5F8"/>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Foreground" Value="#F3F5F8"/><Setter Property="Background" Value="#121720"/>
      <Setter Property="BorderBrush" Value="#303B4A"/><Setter Property="Padding" Value="10,8"/>
      <Setter Property="FontSize" Value="14"/><Setter Property="MinHeight" Value="44"/>
    </Style>
    <Style TargetType="ComboBoxItem">
      <Setter Property="Foreground" Value="#F3F5F8"/><Setter Property="Background" Value="#191F28"/>
      <Setter Property="Padding" Value="10,8"/>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="#D9DFE8"/><Setter Property="Margin" Value="0,4,0,0"/>
    </Style>
  </Window.Resources>
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Grid.RowDefinitions><RowDefinition Height="74"/><RowDefinition Height="*"/></Grid.RowDefinitions>

    <Border Grid.Column="0" Grid.RowSpan="2" Background="#151A22" BorderBrush="#29313D" BorderThickness="0,0,1,0">
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Top" Margin="24,28,20,30">
          <TextBlock Text="POC MALAGA" FontSize="13" FontWeight="Bold" Foreground="#E7ECF5"/>
          <TextBlock Text="ATELIER LOCAL" FontSize="11" Margin="0,5,0,0" Foreground="#778397"/>
        </StackPanel>
        <StackPanel>
          <Button x:Name="NavCreate" Content="  ◇   Créer" HorizontalContentAlignment="Left" Margin="9,0,9,8" Background="#233047" BorderBrush="#4069CF"/>
          <Button x:Name="NavHistory" Content="  ◷   Historique" HorizontalContentAlignment="Left" Margin="9,0,9,8" Background="Transparent" BorderBrush="Transparent" Foreground="#A8B2C1"/>
          <Button x:Name="NavSettings" Content="  ⚙   Réglages" HorizontalContentAlignment="Left" Margin="9,0,9,8" Background="Transparent" BorderBrush="Transparent" Foreground="#A8B2C1"/>
        </StackPanel>
        <Border DockPanel.Dock="Bottom" BorderBrush="#29313D" BorderThickness="0,1,0,0" Padding="18,16" Margin="0,10,0,0">
          <StackPanel Orientation="Horizontal"><Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#D6A34A" Margin="0,0,9,0"/><TextBlock x:Name="StatusLabel" Text="Connexion au moteur…" Foreground="#98A3B4" FontSize="12"/></StackPanel>
        </Border>
      </DockPanel>
    </Border>

    <Grid Grid.Column="1" Grid.Row="0" Margin="30,0,32,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel VerticalAlignment="Center"><TextBlock x:Name="PageTitle" Text="Créer une image" FontSize="22" FontWeight="SemiBold"/><TextBlock x:Name="PageSubtitle" Text="Génération privée, directement sur votre machine" Foreground="#98A3B4" FontSize="12" Margin="0,4,0,0"/></StackPanel>
      <Border Grid.Column="1" Background="#1D2631" BorderBrush="#303B4A" BorderThickness="1" CornerRadius="16" Padding="12,7" VerticalAlignment="Center"><TextBlock x:Name="GpuBadge" Text="GPU · détection…" FontSize="12" Foreground="#C1CAD7"/></Border>
    </Grid>

    <Grid Grid.Column="1" Grid.Row="1" Margin="30,12,30,28">
      <Grid x:Name="CreatePage" Visibility="Visible">
        <Grid.ColumnDefinitions><ColumnDefinition Width="480"/><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="14" Padding="24">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <DockPanel><TextBlock Text="Prompt" FontSize="15" FontWeight="SemiBold"/><TextBlock x:Name="CharacterCount" DockPanel.Dock="Right" Text="0 / 1000" Foreground="{StaticResource MutedBrush}" FontSize="12" VerticalAlignment="Center"/></DockPanel>
              <TextBox x:Name="PromptBox" Height="168" Margin="0,12,0,22" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" MaxLength="1000"/>
              <TextBlock Text="Modèle" FontWeight="SemiBold" Margin="0,0,0,8"/>
              <ComboBox x:Name="ModelBox" SelectedIndex="0" Margin="0,0,0,16">
                <ComboBoxItem Tag="flux3" Content="FLUX 3 Image Klein  ·  FP8"/>
                <ComboBoxItem Tag="qwen21" Content="Qwen-Image-2.1  ·  BF16"/>
              </ComboBox>
              <TextBlock Text="Format" FontWeight="SemiBold" Margin="0,0,0,8"/>
              <ComboBox x:Name="ResolutionBox" SelectedIndex="1" Margin="0,0,0,15">
                <ComboBoxItem Tag="512x512" Content="Carré compact  ·  512 × 512"/>
                <ComboBoxItem Tag="1024x1024" Content="Carré  ·  1024 × 1024"/>
                <ComboBoxItem Tag="832x1216" Content="Portrait  ·  832 × 1216"/>
                <ComboBoxItem Tag="1216x832" Content="Paysage  ·  1216 × 832"/>
              </ComboBox>
              <CheckBox x:Name="UpsamplingBox" Content="Améliorer le prompt (FLUX uniquement)" IsChecked="False" Margin="0,0,0,15"/>
              <DockPanel Margin="0,0,0,16"><TextBlock Text="Image de référence" FontWeight="SemiBold" VerticalAlignment="Center"/><Button x:Name="ReferenceButton" Content="Choisir une image" DockPanel.Dock="Right" Padding="10,7" FontSize="12"/></DockPanel>
              <TextBlock x:Name="ReferenceLabel" Text="Aucune image sélectionnée" Foreground="{StaticResource MutedBrush}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,-8,0,14"/>
              <Button x:Name="GenerateButton" Content="✦   Générer l’image" Background="#416FF0" BorderBrush="#5C86FF" FontSize="16" FontWeight="SemiBold" Padding="16,14"/>
              <TextBlock x:Name="GenerationStatus" Text="Les modèles sont chargés à la demande." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,12,0,0" FontSize="12"/>
            </StackPanel>
          </ScrollViewer>
        </Border>
        <Border Grid.Column="2" Background="#0D1117" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="14" ClipToBounds="True">
          <Grid>
            <StackPanel x:Name="ResultPlaceholder" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420" Margin="28">
              <TextBlock Text="✧" FontSize="52" Foreground="#4B7DFF" HorizontalAlignment="Center"/>
              <TextBlock Text="Votre image apparaîtra ici" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,16,0,8"/>
              <TextBlock Text="Écrivez un prompt, choisissez un modèle local, puis lancez la génération." Foreground="#98A3B4" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center"/>
            </StackPanel>
            <Image x:Name="ResultImage" Stretch="Uniform" Visibility="Collapsed"/>
            <Border VerticalAlignment="Bottom" Background="#E610141B" Padding="18,13">
              <TextBlock x:Name="ResultMeta" Text="Aucune génération pour le moment" Foreground="#D0D6DF" TextTrimming="CharacterEllipsis"/>
            </Border>
          </Grid>
        </Border>
      </Grid>

      <Grid x:Name="HistoryPage" Visibility="Collapsed">
        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="14" Padding="22">
          <DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,18"><TextBlock Text="Images générées sur cette machine" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/><Button x:Name="RefreshHistoryButton" Content="Actualiser" DockPanel.Dock="Right" Padding="12,7"/></DockPanel>
            <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="HistoryItems"/></ScrollViewer>
          </DockPanel>
        </Border>
      </Grid>

      <Grid x:Name="SettingsPage" Visibility="Collapsed">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel MaxWidth="900" HorizontalAlignment="Left">
            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="14" Padding="24" Margin="0,0,0,16">
              <StackPanel><TextBlock Text="État de l’application" FontSize="17" FontWeight="SemiBold"/><TextBlock x:Name="HealthDetails" Text="Connexion au serveur local…" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,12,0,16"/><Button x:Name="RefreshHealthButton" Content="Actualiser l’état" HorizontalAlignment="Left"/></StackPanel>
            </Border>
            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="14" Padding="24" Margin="0,0,0,16">
              <StackPanel><TextBlock Text="Modèles installés séparément" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="FLUX 3 Image Klein — FP8, chargé par étapes pour limiter la mémoire. Le débruitage demande toujours une forte quantité de VRAM." Foreground="#B3BDCB" TextWrapping="Wrap" Margin="0,12,0,10"/><TextBlock Text="Qwen-Image-2.1 — BF16, avec déchargement vers le CPU sur les GPU de moins de 20 Go." Foreground="#B3BDCB" TextWrapping="Wrap"/></StackPanel>
            </Border>
            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="14" Padding="24">
              <StackPanel><TextBlock Text="Données locales" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Les générations et l’historique sont conservés dans le dossier outputs de ce projet. Les poids des modèles sont téléchargés séparément depuis WSL2." Foreground="#B3BDCB" TextWrapping="Wrap" Margin="0,12,0,0"/></StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Grid>
  </Grid>
</Window>
